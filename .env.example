# Copie este arquivo para ".env" e preencha os valores.
# O arquivo .env NÃO vai para o GitHub. No site (Vercel), os valores ficam em
# Settings -> Environment Variables.

# Site (React/Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Bot do Telegram (src/bot.ts)
TELEGRAM_BOT_TOKEN=
VITE_SUPABASE_PUBLISHABLE_KEY=

# (opcional) nome do bot no Telegram, sem @, para o link na tela Telegram
VITE_TELEGRAM_BOT_USERNAME=
